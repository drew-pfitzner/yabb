{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git switch:*)", "Bash(git checkout:*)", "Bash(git branch:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git merge:*)", "Bash(git push -u origin:*)", "Bash(git push origin:*)", "Bash(git revert:*)",
      "Bash(git rev-parse:*)", "Bash(git rev-list:*)",
      "Bash(gh pr:*)", "Bash(gh run:*)",
      "Bash(npm test:*)", "Bash(npm run dev:*)", "Bash(node --check:*)", "Bash(sh scripts/check-private.sh:*)",
      "Bash(curl -s https://ynabb.tail8c1464.ts.net/api/health:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Read(./private-data/**)", "Read(./.env)"
    ]
  }
}
